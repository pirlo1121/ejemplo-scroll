---
/** Página no encontrada. Los hostings estáticos la sirven para cualquier ruta inexistente. */
import Boton from '@/components/ui/Boton.astro';
import Base from '@/layouts/Base.astro';
---

<Base
  titulo="Página no encontrada · JAPH"
  descripcion="La página que buscas no existe o cambió de dirección."
>
  <section class="envoltura portada-pagina" aria-labelledby="titulo-404">
    <h1 id="titulo-404">
      Esta página <em>no existe</em>.
    </h1>
    <p class="plomo">Puede que el enlace esté roto o que la página haya cambiado de dirección.</p>
    <p>
      <Boton href="/" variante="solido">
        Volver a la portada
      </Boton>
    </p>
  </section>
</Base>
