---
/**
 * Capítulo 2 · El ecosistema — "a través de la O".
 *
 * La palabra gigante "ecosistema" tiene la O dibujada como un anillo, que
 * enmarca la esfera de partículas del fondo. Al bajar, la cámara vuela a
 * través del hueco de esa O y, del otro lado, aparece el manifiesto, que se
 * entinta cláusula por cláusula mientras se lee.
 *
 * Todo el movimiento sale de --p (modo "fija") y se calcula en el CSS.
 * scripts/historia/manifiesto.ts solo mide dónde está el anillo.
 *
 * Sin movimiento, la palabra no se muestra y el manifiesto es un párrafo normal.
 */
import Rotulo from '@/components/ui/Rotulo.astro';

const clausulas = [
  'Una presencia digital sana funciona como un ecosistema:',
  'el sitio atrae,',
  'la automatización responde,',
  'el producto retiene,',
  'el contenido sostiene',
  'y la marca le da sentido a todo lo demás.'
];
---

<section
  class="manifiesto"
  id="manifiesto"
  aria-label="Nuestra forma de ver el trabajo digital"
  data-escena="esfera"
  data-progreso="fija"
  data-manifiesto
>
  <div class="marco">
    <p class="portal" aria-hidden="true" data-portal>
      <span class="letras">ec</span>
      <span class="anillo" data-anillo></span>
      <span class="letras">sistema</span>
    </p>

    <div class="envoltura contenido">
      <Rotulo numero="02">Manifiesto</Rotulo>
      <p class="texto">
        {clausulas.map((clausula, i) => (
          <>
            <span class="clausula" style={{ '--i': i }}>
              {clausula}
            </span>{' '}
          </>
        ))}
      </p>
    </div>
  </div>
</section>

<script>
  import { iniciarManifiesto } from '@/scripts/historia/manifiesto';
  iniciarManifiesto();
</script>

<style>
  .manifiesto {
    padding-block: var(--bloque);
  }

  .texto {
    margin-top: 1.25rem;
    font-family: var(--display);
    font-weight: 300;
    font-size: clamp(1.7rem, 3.6vw, 3.4rem);
    line-height: 1.2;
    letter-spacing: -0.035em;
    max-width: 24ch;
  }

  .portal {
    display: none;
  }

  /* --- Con movimiento ------------------------------------------------------
     Guion sobre --p (0 → 1 mientras el marco está fijo):
       0.06 – 0.56  vuelo a través de la O (--t)
       0.42 – 0.56  el manifiesto llega desde el fondo (--r)
       0.50 – 0.95  cada cláusula se entinta, una tras otra (--q)
     ------------------------------------------------------------------------- */
  :global(.movimiento) .manifiesto {
    height: 340vh;
    padding: 0;
  }

  :global(.movimiento) .marco {
    position: sticky;
    top: 0;
    height: 100svh;
    display: grid;
    align-items: center;
    overflow: hidden;
  }

  /* La palabra-portal.
     - Se centra en el marco con inset + margin: auto, sin transform, que queda
       libre para el vuelo.
     - Es flex para ignorar los espacios entre "ec", el anillo y "sistema": así
       el formateo del código nunca separa la palabra.
     - La cámara se acerca a la O (transform-origin) y a la vez la lleva al
       centro de la pantalla (translate). La escala crece al cubo: empieza lenta
       y se precipita.
     - Sin will-change a propósito: congelaría la capa a su tamaño inicial y el
       anillo se vería pixelado al ampliarlo 70 veces. Es una sola palabra, así
       que volver a dibujarla nítida en cada escala es barato. */
  :global(.movimiento) .portal {
    --t: clamp(0, calc((var(--p, 0) - 0.06) / 0.5), 1);
    position: absolute;
    inset: 0;
    z-index: 1;
    display: flex;
    align-items: baseline;
    width: max-content;
    height: max-content;
    margin: auto;
    font-family: var(--display);
    font-weight: 600;
    font-size: clamp(3.5rem, 15vw, 15rem);
    line-height: 1;
    letter-spacing: -0.05em;
    white-space: nowrap;
    pointer-events: none;
    transform-origin: var(--origen-x, 50%) var(--origen-y, 50%);
    transform: translate3d(
        calc(var(--hacia-x, 0px) * var(--t)),
        calc(var(--hacia-y, 0px) * var(--t)),
        0
      )
      scale(calc(1 + 69 * var(--t) * var(--t) * var(--t)));
    opacity: calc((1 - var(--t)) * 5);
  }

  .letras {
    background: var(--savia);
    background-size: 100vw 100%;
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }

  /* La O es un anillo dibujado: su hueco es transparente y deja ver la
     esfera de partículas que hay detrás. */
  .anillo {
    display: inline-block;
    width: 0.56em;
    height: 0.56em;
    margin-inline: 0.02em;
    border-radius: 50%;
    background: conic-gradient(
      from 200deg,
      var(--indigo),
      var(--azul),
      var(--cian),
      var(--hielo),
      var(--indigo)
    );
    mask: radial-gradient(circle, transparent 55%, #000 56%);
    vertical-align: baseline;
  }

  /* El manifiesto espera del otro lado de la O y avanza hacia la cámara. */
  :global(.movimiento) .contenido {
    --r: clamp(0, calc((var(--p, 0) - 0.42) / 0.14), 1);
    opacity: var(--r);
    transform: scale(calc(0.86 + var(--r) * 0.14));
    transform-origin: 30% 50%;
  }

  /* Cada cláusula se llena de tinta de izquierda a derecha, con un borde cian
     que avanza. En un párrafo de varias líneas, el fondo recorre los
     fragmentos en orden de lectura. */
  :global(.movimiento) .clausula {
    --q: clamp(0, calc((var(--p, 0) - 0.5 - var(--i) * 0.075) / 0.075), 1);
    background-image: linear-gradient(
      90deg,
      var(--texto) 0 44%,
      var(--cian) 49%,
      rgb(233 239 251 / 0.14) 53% 100%
    );
    background-size: 220% 100%;
    background-position: calc((1 - var(--q)) * 100%) 0;
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }
</style>
