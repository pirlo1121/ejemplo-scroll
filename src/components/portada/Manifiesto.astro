---
/**
 * Capítulo 2 · El ecosistema.
 *
 * La palabra gigante "ecosistema" tiene la O dibujada como un anillo que
 * gira despacio y deja ver la esfera de partículas del fondo. Debajo, el
 * manifiesto: una cláusula por línea, y cada una se entinta cuando cruza la
 * línea de lectura (scripts/historia/manifiesto.ts pone .esta-entintada).
 *
 * La sección no se fija ni alarga el scroll: mide lo que mide su contenido,
 * así que en el celular se recorre igual de natural que en el escritorio.
 *
 * Sin movimiento, la palabra está quieta y el manifiesto se lee en tinta plena.
 */
import Rotulo from '@/components/ui/Rotulo.astro';

const clausulas = [
  'Una presencia digital sana funciona como un ecosistema:',
  'el sitio atrae,',
  'la automatización responde,',
  'el producto retiene,',
  'el contenido sostiene',
  'y la marca le da sentido a todo lo demás.'
];
---

<section
  class="manifiesto"
  id="manifiesto"
  aria-label="Nuestra forma de ver el trabajo digital"
  data-escena="esfera"
>
  <div class="envoltura">
    <Rotulo numero="02">Manifiesto</Rotulo>

    <p class="portal" aria-hidden="true" data-revelar>
      <span class="letras">ec</span>
      <span class="anillo"></span>
      <span class="letras">sistema</span>
    </p>

    <p class="texto">
      {clausulas.map((clausula, i) => (
        <>
          <span class="clausula" data-clausula style={{ '--i': i }}>
            {clausula}
          </span>{' '}
        </>
      ))}
    </p>
  </div>
</section>

<script>
  import { iniciarManifiesto } from '@/scripts/historia/manifiesto';
  iniciarManifiesto();
</script>

<style>
  .manifiesto {
    padding-block: var(--bloque);
  }

  /* --- La palabra-portal ----------------------------------------------------
     Es flex para ignorar los espacios entre "ec", el anillo y "sistema": así
     el formateo del código nunca separa la palabra. El tamaño está pensado
     para que "ecosistema" quepa entera en un teléfono de 320 px. */
  .portal {
    display: flex;
    align-items: baseline;
    margin-block: clamp(1.5rem, 4vw, 2.5rem) clamp(2rem, 6vw, 4.5rem);
    font-family: var(--display);
    font-weight: 600;
    font-size: clamp(2.6rem, 14.5vw, 13rem);
    line-height: 1;
    letter-spacing: -0.05em;
    white-space: nowrap;
  }

  .letras {
    background: var(--savia);
    background-size: 100vw 100%;
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }

  /* La O es un anillo dibujado: su hueco es transparente y deja ver la
     esfera de partículas que hay detrás. El ángulo del degradado es una
     propiedad registrada para poder animarlo (ver @keyframes girar). */
  @property --giro-anillo {
    syntax: '<angle>';
    inherits: false;
    initial-value: 200deg;
  }

  .anillo {
    display: inline-block;
    flex: none;
    width: 0.56em;
    height: 0.56em;
    margin-inline: 0.02em;
    border-radius: 50%;
    background: conic-gradient(
      from var(--giro-anillo),
      var(--indigo),
      var(--azul),
      var(--cian),
      var(--hielo),
      var(--indigo)
    );
    mask: radial-gradient(circle, transparent 55%, #000 56%);
  }

  /* --- El manifiesto -------------------------------------------------------- */
  .texto {
    font-family: var(--display);
    font-weight: 300;
    font-size: clamp(1.6rem, 3.6vw, 3.4rem);
    line-height: 1.2;
    letter-spacing: -0.035em;
    max-width: 26ch;
  }

  /* Una cláusula por línea: se lee como un manifiesto y cada línea tiene su
     propio momento al pasar por la línea de lectura. */
  .clausula {
    display: block;
  }

  .clausula + .clausula {
    margin-top: 0.12em;
  }

  /* --- Con movimiento ------------------------------------------------------- */

  /* El anillo entra girando y creciendo, y después su degradado sigue
     girando despacio. La animación mueve el ángulo del degradado, no el
     anillo: así no pelea con la transición de entrada, que usa transform. */
  :global(.movimiento) .anillo {
    transform: scale(0.2) rotate(-200deg);
    transition: transform 1.4s var(--curva) 0.15s;
    animation: girar 14s linear infinite paused;
  }

  :global(.movimiento) .portal:global(.es-visible) .anillo {
    transform: none;
    animation-play-state: running;
  }

  @keyframes girar {
    to {
      --giro-anillo: 560deg;
    }
  }

  /* Cada cláusula se llena de tinta de izquierda a derecha, con un borde cian
     que avanza. Es una transición por tiempo: no depende de la velocidad del
     dedo ni de la rueda, así que se ve igual de suave en cualquier equipo. */
  :global(.movimiento) .clausula {
    background-image: linear-gradient(
      90deg,
      var(--texto) 0 44%,
      var(--cian) 49%,
      rgb(233 239 251 / 0.14) 53% 100%
    );
    background-size: 220% 100%;
    background-position: 100% 0;
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    transition: background-position 1.3s var(--curva);
    transition-delay: var(--retardo, 0s);
  }

  :global(.movimiento) .clausula:global(.esta-entintada) {
    background-position: 0 0;
  }
</style>
