---
/**
 * Capítulo 3 · Siete capacidades — "órbita".
 *
 * Los siete servicios forman un anillo 3D, igual que los siete cúmulos de
 * partículas que la escena dibuja detrás. El scroll hace girar el anillo y
 * se detiene en cada servicio (scripts/historia/orbita.ts escribe --giro).
 *
 * Sin movimiento, las fichas son una rejilla normal y se leen en orden.
 */
import CabeceraDeSeccion from '@/components/ui/CabeceraDeSeccion.astro';
import IconoDeServicio from '@/components/ui/IconoDeServicio.astro';
import { servicios } from '@/datos/servicios';

const total = String(servicios.length).padStart(2, '0');
---

<section
  class="seccion"
  id="servicios"
  aria-labelledby="titulo-servicios"
  data-escena="constelacion"
>
  <div class="envoltura">
    <CabeceraDeSeccion
      id="titulo-servicios"
      titulo="Siete capacidades, <em>un mismo sistema</em>"
      rotulo={{ numero: '03', texto: 'Servicios' }}
    >
      <p class="plomo" data-revelar>
        Puedes contratar una sola. Rinden más cuando se alimentan entre ellas.
      </p>
    </CabeceraDeSeccion>
  </div>

  <div class="escenario" data-orbita style={{ '--total': servicios.length }}>
    <div class="marco">
      <p class="contador" aria-hidden="true">
        <span data-orbita-actual>01</span>
        <span class="total">/ {total}</span>
      </p>

      <div class="inclinacion">
        <ol class="anillo">
          {servicios.map((servicio, i) => (
            <li class="carta" data-carta style={{ '--i': i }}>
              <article class="capacidad">
                <div class="cabeza">
                  <span class="numero" aria-hidden="true">
                    {String(i + 1).padStart(2, '0')}
                  </span>
                  <IconoDeServicio servicio={servicio.id} />
                </div>
                <h3>{servicio.nombre}</h3>
                <p>{servicio.resumen}</p>
              </article>
            </li>
          ))}
        </ol>
      </div>

      <ol class="puntos" aria-hidden="true">
        {servicios.map(() => (
          <li data-punto />
        ))}
      </ol>
    </div>
  </div>

  <div class="envoltura">
    <p class="accion-final" data-revelar>
      <a class="enlace-subrayado" href="/servicios">
        Ver el detalle de cada servicio
      </a>
    </p>
  </div>
</section>

<script>
  import { iniciarOrbita } from '@/scripts/historia/orbita';
  iniciarOrbita();
</script>

<style>
  /* --- Sin movimiento: rejilla simple ------------------------------------- */
  .escenario {
    padding-inline: var(--gutter);
  }

  .anillo {
    display: grid;
    gap: clamp(1rem, 2.5vw, 1.5rem);
    max-width: var(--ancho);
    margin-inline: auto;
  }

  .contador,
  .puntos {
    display: none;
  }

  .capacidad {
    position: relative;
    display: grid;
    align-content: start;
    gap: 1rem;
    height: 100%;
    padding: clamp(1.5rem, 3vw, 2.25rem);
    border: 1px solid var(--linea);
    border-radius: 28px;
    background:
      radial-gradient(30rem 14rem at 100% 0%, rgb(47 125 255 / 0.16), transparent 70%),
      linear-gradient(180deg, #0c1428, #080e1d);
    transition:
      border-color var(--medio),
      box-shadow var(--medio);
  }

  .cabeza {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 1.5rem;
  }

  .numero {
    padding-right: 0.1em;
    font-family: var(--acento-fuente);
    font-style: italic;
    font-size: clamp(3rem, 6vw, 5rem);
    line-height: 0.8;
    background: var(--savia);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }

  h3 {
    font-size: var(--t-2);
  }

  .capacidad p {
    color: var(--texto-suave);
  }

  @media (min-width: 46rem) {
    .anillo {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  /* --- Con movimiento: el anillo 3D ---------------------------------------
     El radio sale del ancho de ficha para que las siete cierren el círculo
     con aire entre ellas: r = ancho / (2·tan(π/7)) ≈ ancho × 1.04, más holgura. */
  :global(.movimiento) .escenario {
    --ancho-carta: min(76vw, 25rem);
    --radio: calc(var(--ancho-carta) * 1.22);
    --paso: calc(360deg / var(--total));
    height: calc(var(--total) * 65svh);
    padding: 0;
  }

  :global(.movimiento) .marco {
    position: sticky;
    top: 0;
    height: 100svh;
    display: grid;
    place-items: center;
    overflow: hidden;
    perspective: 1500px;
    perspective-origin: 50% 35%;
  }

  /* Se ve el anillo un poco desde arriba: así se percibe como órbita. */
  :global(.movimiento) .inclinacion {
    transform: rotateX(-7deg);
    transform-style: preserve-3d;
  }

  :global(.movimiento) .anillo {
    display: block;
    position: relative;
    width: var(--ancho-carta);
    height: min(26rem, 62svh);
    margin: 0;
    transform-style: preserve-3d;
    transform: translateZ(calc(var(--radio) * -1)) rotateY(calc(var(--giro, 0) * var(--paso) * -1));
    will-change: transform;
  }

  :global(.movimiento) .carta {
    /* Cuánto mira la ficha hacia la cámara: 1 de frente, 0 de perfil. */
    --frente: cos(calc((var(--i) - var(--giro, 0)) * var(--paso)));
    position: absolute;
    inset: 0;
    transform: rotateY(calc(var(--i) * var(--paso))) translateZ(var(--radio));
    backface-visibility: hidden;
    opacity: clamp(0.06, calc(var(--frente) * 1.3 - 0.3), 1);
  }

  :global(.movimiento) .esta-al-frente .capacidad {
    border-color: rgb(90 210 255 / 0.5);
    box-shadow:
      0 0 0 1px rgb(90 210 255 / 0.15),
      0 30px 80px rgb(47 125 255 / 0.25);
  }

  :global(.movimiento) .contador {
    position: absolute;
    top: calc(var(--alto-cabecera) + 1.5rem);
    left: var(--gutter);
    display: flex;
    align-items: baseline;
    gap: 0.5rem;
    font-family: var(--acento-fuente);
    font-style: italic;
    font-size: clamp(2.5rem, 6vw, 4.5rem);
    line-height: 1;
    color: var(--acento);
  }

  .total {
    font-family: var(--texto-fuente);
    font-style: normal;
    font-size: var(--t-0);
    color: var(--texto-suave);
  }

  :global(.movimiento) .puntos {
    position: absolute;
    bottom: clamp(1.5rem, 5svh, 3rem);
    left: 50%;
    display: flex;
    gap: 0.5rem;
    translate: -50% 0;
  }

  .puntos li {
    width: 1.5rem;
    height: 2px;
    border-radius: 2px;
    background: var(--linea-fuerte);
    transition:
      width var(--medio),
      background-color var(--medio);
  }

  .puntos li.esta-activo {
    width: 3rem;
    background: var(--acento);
  }
</style>
