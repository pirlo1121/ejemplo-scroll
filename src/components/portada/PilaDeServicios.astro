---
/**
 * Capítulo 3 · Siete capacidades. Las partículas forman siete cúmulos.
 * Con movimiento, cada ficha queda fija un poco más abajo que la anterior
 * y se hunde cuando llega la siguiente (scripts/historia/pila.ts).
 */
import CabeceraDeSeccion from '@/components/ui/CabeceraDeSeccion.astro';
import IconoDeServicio from '@/components/ui/IconoDeServicio.astro';
import { servicios } from '@/datos/servicios';
---

<section
  class="seccion"
  id="servicios"
  aria-labelledby="titulo-servicios"
  data-escena="constelacion"
>
  <div class="envoltura">
    <CabeceraDeSeccion
      id="titulo-servicios"
      titulo="Siete capacidades, <em>un mismo sistema</em>"
      rotulo={{ numero: '03', texto: 'Servicios' }}
    >
      <p class="plomo" data-revelar>
        Puedes contratar una sola. Rinden más cuando se alimentan entre ellas.
      </p>
    </CabeceraDeSeccion>

    <ol class="pila" data-pila>
      {servicios.map((servicio, i) => (
        <li class="carta" data-carta style={{ '--i': i }}>
          <article class="capacidad">
            <div class="cabeza">
              <span class="numero" aria-hidden="true">
                {String(i + 1).padStart(2, '0')}
              </span>
              <IconoDeServicio servicio={servicio.id} />
            </div>
            <div class="cuerpo">
              <h3>{servicio.nombre}</h3>
              <p>{servicio.resumen}</p>
            </div>
          </article>
        </li>
      ))}
    </ol>

    <p class="accion-final" data-revelar>
      <a class="enlace-subrayado" href="/servicios">
        Ver el detalle de cada servicio
      </a>
    </p>
  </div>
</section>

<script>
  import { iniciarPila } from '@/scripts/historia/pila';
  iniciarPila();
</script>

<style>
  .pila {
    display: grid;
    gap: clamp(1rem, 2.5vw, 1.5rem);
  }

  .capacidad {
    position: relative;
    display: grid;
    gap: 1.5rem;
    min-height: clamp(15rem, 34vh, 21rem);
    padding: clamp(1.6rem, 3.5vw, 3rem);
    overflow: hidden;
    border: 1px solid var(--linea);
    border-radius: 28px;
    background:
      radial-gradient(40rem 18rem at 100% 0%, rgb(47 125 255 / 0.14), transparent 70%),
      linear-gradient(180deg, #0c1428, #080e1d);
    box-shadow: 0 -18px 48px rgb(0 0 0 / 0.45);
    transform-origin: 50% 0;
  }

  /* Sombra que cae sobre la ficha cuando la siguiente la tapa. */
  .capacidad::after {
    content: '';
    position: absolute;
    inset: 0;
    background: var(--tinta);
    opacity: calc(var(--hundido, 0) * 0.55);
    pointer-events: none;
  }

  .cabeza {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 1rem;
  }

  .numero {
    padding-right: 0.1em;
    font-family: var(--acento-fuente);
    font-style: italic;
    font-size: clamp(3.5rem, 8vw, 7rem);
    line-height: 0.8;
    background: var(--savia);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }

  .cuerpo h3 {
    margin-bottom: 0.9rem;
    font-size: var(--t-3);
  }

  .cuerpo p {
    color: var(--texto-suave);
    max-width: 44ch;
  }

  /* Con movimiento: fichas fijas escalonadas que se hunden al ser tapadas. */
  :global(.movimiento) .pila {
    gap: clamp(3rem, 12vh, 7rem);
  }

  :global(.movimiento) .carta {
    position: sticky;
    top: calc(5.5rem + var(--i) * 0.9rem);
  }

  :global(.movimiento) .capacidad {
    transform: scale(calc(1 - var(--hundido, 0) * 0.05));
  }

  @media (min-width: 52rem) {
    .capacidad {
      grid-template-columns: 0.8fr 1.2fr;
      align-items: end;
      gap: 3rem;
    }

    .cabeza {
      flex-direction: column;
      align-self: stretch;
    }

    :global(.movimiento) .carta {
      top: calc(16vh + var(--i) * 1.1rem);
    }
  }
</style>
