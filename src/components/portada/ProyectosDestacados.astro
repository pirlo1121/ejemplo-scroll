---
/**
 * Capítulo 5 · Proyectos. La escena se aplana en una onda. Con movimiento,
 * la ventana de cada ficha se abre al entrar (--p en modo "entrada").
 */
import { Image } from 'astro:assets';
import CabeceraDeSeccion from '@/components/ui/CabeceraDeSeccion.astro';
import NotaEjemplo from '@/components/ui/NotaEjemplo.astro';
import SelloEjemplo from '@/components/ui/SelloEjemplo.astro';
import { destacados } from '@/datos/proyectos';

const hayEjemplos = destacados.some((proyecto) => proyecto.ejemplo);
---

<section
  class="seccion"
  id="proyectos-destacados"
  aria-labelledby="titulo-destacados"
  data-escena="onda"
>
  <div class="envoltura">
    <CabeceraDeSeccion
      id="titulo-destacados"
      titulo="Proyectos destacados"
      rotulo={{ numero: '05', texto: 'Proyectos' }}
    >
      {hayEjemplos && (
        <NotaEjemplo titulo="Contenido de ejemplo.">
          Los tres casos de esta sección son marcadores de posición para mostrar la maqueta.
          Sustituye nombres, descripciones e imágenes por proyectos reales de JAPH antes de publicar
          el sitio.
        </NotaEjemplo>
      )}
    </CabeceraDeSeccion>

    <div class="destacados">
      {destacados.map((proyecto, i) => (
        <article class="destacado" data-progreso="entrada">
          <div class="visual">
            {proyecto.imagen ? (
              <Image
                class="medio"
                src={proyecto.imagen}
                alt={proyecto.alt ?? ''}
                widths={[480, 800, 1200, 1600]}
                sizes={
                  i === 0 ? '(min-width: 56rem) 84rem, 100vw' : '(min-width: 56rem) 42rem, 100vw'
                }
              />
            ) : (
              <div class:list={['medio', 'pintura', `tono-${proyecto.tono}`]} aria-hidden="true" />
            )}
          </div>
          <div class="pie">
            <div>
              <h3>{proyecto.titulo}</h3>
              <p>{proyecto.descripcion}</p>
            </div>
            {proyecto.ejemplo && <SelloEjemplo />}
          </div>
        </article>
      ))}
    </div>

    <p class="accion-final" data-revelar>
      <a class="enlace-subrayado" href="/proyectos">
        Ver todos los proyectos
      </a>
    </p>
  </div>
</section>

<style>
  .destacados {
    display: grid;
    gap: clamp(1rem, 2.5vw, 1.75rem);
  }

  .destacado {
    overflow: hidden;
    border: 1px solid var(--linea);
    border-radius: 24px;
    background: var(--superficie);
    transition: border-color var(--medio);
  }

  .destacado:hover {
    border-color: var(--linea-fuerte);
  }

  .visual {
    position: relative;
    aspect-ratio: 16 / 10;
    overflow: hidden;
    background: var(--tinta-media);
  }

  .medio {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 1.1s var(--curva);
  }

  /* Degradado provisional mientras no hay imagen real. */
  .pintura {
    inset: -12%;
    width: auto;
    height: auto;
    filter: blur(30px) saturate(1.1);
    opacity: 0.65;
    transition: opacity var(--medio);
  }

  .destacado:hover .pintura {
    opacity: 0.85;
  }

  .tono-1 {
    background: linear-gradient(120deg, var(--indigo), var(--azul) 55%, var(--cian));
  }
  .tono-2 {
    background: linear-gradient(150deg, var(--azul), var(--indigo) 60%, var(--azul-profundo));
  }
  .tono-3 {
    background: linear-gradient(200deg, var(--cian), var(--azul) 50%, var(--indigo));
  }

  /* Con movimiento: la ventana se abre al entrar y la imagen se asienta. */
  :global(.movimiento) .visual {
    clip-path: inset(calc((1 - var(--p, 0)) * 14%) calc((1 - var(--p, 0)) * 8%) round 18px);
  }

  :global(.movimiento) .medio {
    transform: scale(calc(1.25 - var(--p, 0) * 0.25));
  }

  .pie {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 1.25rem;
    padding: 1.35rem clamp(1.25rem, 3vw, 2rem) 1.65rem;
  }

  h3 {
    font-size: var(--t-1);
  }

  .pie p {
    margin-top: 0.4rem;
    font-size: var(--t--1);
    color: var(--texto-suave);
  }

  @media (min-width: 56rem) {
    .destacados {
      grid-template-columns: repeat(2, 1fr);
    }

    .destacado:first-child {
      grid-column: 1 / -1;
    }

    .destacado:first-child .visual {
      aspect-ratio: 21 / 9;
    }
  }
</style>
