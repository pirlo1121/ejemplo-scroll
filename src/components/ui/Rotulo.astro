---
/**
 * Rótulo de capítulo: "02 — Manifiesto". Es decorativo: el titular de la
 * sección ya transmite el sentido, así que se oculta a los lectores de pantalla.
 */
interface Props {
  numero: string;
}

const { numero } = Astro.props;
---

<p class="rotulo" aria-hidden="true">
  <span>{numero}</span> <slot />
</p>

<style>
  .rotulo {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    font-size: var(--t--1);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--texto-suave);
  }

  span {
    font-family: var(--acento-fuente);
    font-style: italic;
    font-size: 1.35em;
    letter-spacing: 0;
    text-transform: none;
    color: var(--acento);
  }

  .rotulo::after {
    content: '';
    width: 3rem;
    height: 1px;
    background: linear-gradient(90deg, var(--acento), transparent);
  }
</style>
